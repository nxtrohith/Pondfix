# Copy to .env.local (git-ignored) and set the address of the AquaGuard backend as seen from the PHONE.
# Use this computer's LAN IP, never localhost. macOS: ipconfig getifaddr en0
# The backend must listen on the network: start it with HOST=0.0.0.0 (backend/.env). Phone and computer must be on the same Wi-Fi.
# For production use the deployed HTTPS address, e.g. https://api.example.com
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
