# Frontend configuration. Only values safe for the browser belong here (NEXT_PUBLIC_*).
# Never put MONGODB_URI or any database/server secret in the frontend.

# Base URL of the AquaGuard API (includes /api). Used by the browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api

# Optional: server-side (Next.js server components) base URL if it differs from the browser's
# API_BASE_URL=http://127.0.0.1:4000/api

# IANA time zone used to display timestamps (data is stored in UTC). Default: UTC
# NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Kolkata
