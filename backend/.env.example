# Backend environment. Copy to backend/.env (git-ignored) and fill in. Never commit .env or paste its contents anywhere.
# Read by: the API (backend/src), the database scripts (database/, which share the connection) and the Python worker (selected values only).

# --- MongoDB Atlas (server-side only) ---
# Atlas UI > Connect > Drivers. Contains the password, so rotate it if it was ever shared.
MONGODB_URI=
MONGODB_DB=aquaguard

# --- API (all optional; defaults shown) ---
PORT=4000
# Use HOST=0.0.0.0 so a phone on the same Wi-Fi can reach the API at http://<this machine's LAN IP>:4000 (never use localhost on a phone).
HOST=127.0.0.1
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (the web dashboard, Vite, Expo web).
# Add your own origin here if you open the dashboard from another host, e.g. a LAN address.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Demo endpoints (/api/demo/*) write simulated readings into the Atlas database. Off by default; enable only for a test database.
DEMO_ENABLED=false
# A reading older than this many minutes is reported STALE, never healthy
STALE_AFTER_MINUTES=60
MAX_QUERY_RANGE_DAYS=366
BODY_LIMIT=20kb

# --- Risk rules (optional) ---
# JSON file overriding the DO, pH and temperature limits (keys do|ph|temp; shared with the Python worker). Invalid files stop startup.
# AQUAGUARD_THRESHOLDS=
# --- Species-specific alert limits (optional; none ship with the code) ---
# JSON file of limits that a domain expert has APPROVED per species, e.g.
#   {"rohu":{"version":"rohu-2026-11","approvedBy":"...","approvedAt":"2026-11-02","source":"<document>","limits":{"do":{"low_warn":4,"low_crit":2.5}}}}
# Without it every species uses the general rules above. Invalid files stop startup. See backend/README.md.
# AQUAGUARD_SPECIES_POLICIES=
# Comma list of parameters whose alert rule is switched off: dissolved_oxygen, ph, temperature
# RISK_RULES_DISABLED=

# --- ML inference (Python worker spawned by the API over stdio; no network port) ---
ML_ENABLED=true
PYTHON_BIN=python3
ML_TIMEOUT_MS=30000
# Defaults to ./aquaguard_model.pkl; the worker refuses any file whose SHA-256 is not pinned in ml/MODEL_SHA256
# AQUAGUARD_MODEL_PATH=

# --- Historical import (database/scripts/import-fwi.js) ---
# Folder containing the FWI ara2_*.csv files
# FWI_DATA_DIR=/path/to/Preprocess/csv

# --- Alert advisor: Jev analysis + custom LLM (all optional; off unless JEV_API_KEY is set) ---
# Jev (TypeSafe, https://docs.typesafe.ai) ranks which parameter to handle first, flags likely sensor faults, groups related alerts, recommends a
# notification channel and checks the LLM's advice. Server-side only. Pin JEV_MODEL to a tested version before production ("jev-latest" can move).
# JEV_API_KEY=   (TYPESAFE_API_KEY is accepted as an alias)
# JEV_MODEL=jev-latest
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# Custom OpenAI-compatible chat-completions endpoint that writes the farmer-facing solution for observed CRITICAL alerts.
# Without it the generic guidance text is used. After changing schemas run: npm run db:init -w database && npm run db:indexes -w database
# LLM_ENDPOINT_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Alert call to the farmer: Sarvam Voice Agent (all optional; off unless ALERT_CALLS_ENABLED=true and every value below is set) ---
# After Jev + the LLM finish an OBSERVED CRITICAL alert, the Sarvam agent phones the farmer. Server-side only.
# Sarvam rejects variables the agent has not declared, so none are sent unless listed in SARVAM_AGENT_VARIABLES (comma list of the names the agent
# declares, chosen from: pond_name, parameter, severity, reading, summary, verify_first, first_step, call_type).
# SARVAM_AGENT_VARIABLES=
# ALERT_CALLS_ENABLED=true
# SARVAM_API_KEY=            workspace API key (Sarvam dashboard)
# SARVAM_ORG_ID=             Sarvam dashboard > Voice Agents > Settings
# SARVAM_WORKSPACE_ID=
# SARVAM_AGENT_ID=           the agent's app id (agent "pondfix")
# SARVAM_AGENT_VERSION=1     deployed agent version
# SARVAM_CONNECTION_ID=      telephony connection id
# SARVAM_AGENT_PHONE_NUMBER= number the agent calls FROM (E.164), as configured on the connection
# ALERT_CALL_TO_NUMBER=      farmer's phone, E.164, e.g. +919876543210
# ALERT_CALL_COOLDOWN_MINUTES=30   at most one call per pond in this window
# ALERT_CALL_TEST_MODE=true        agent announces a TEST CALL instead of a REAL ALERT (call_type variable)
# SARVAM_TIMEOUT_MS=10000
