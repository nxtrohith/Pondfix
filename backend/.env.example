# Backend environment. Copy to backend/.env (git-ignored) and fill in. Never commit .env or paste its contents anywhere.
# Read by: the API (backend/src), the database scripts (database/, which share the connection) and the Python worker (selected values only).

# --- MongoDB Atlas (server-side only) ---
# Atlas UI > Connect > Drivers. Contains the password, so rotate it if it was ever shared.
MONGODB_URI=
MONGODB_DB=aquaguard

# --- API (all optional; defaults shown) ---
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (the web dashboard, Vite, Expo web).
# Add your own origin here if you open the dashboard from another host, e.g. a LAN address.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Demo endpoints (/api/demo/*): on by default except when NODE_ENV=production
DEMO_ENABLED=true
# A reading older than this many minutes is reported STALE, never healthy
STALE_AFTER_MINUTES=60
MAX_QUERY_RANGE_DAYS=366
BODY_LIMIT=20kb

# --- Risk rules (optional) ---
# JSON file overriding the DO, pH and temperature limits (keys do|ph|temp; shared with the Python worker). Invalid files stop startup.
# AQUAGUARD_THRESHOLDS=
# Comma list of parameters whose alert rule is switched off: dissolved_oxygen, ph, temperature
# RISK_RULES_DISABLED=

# --- ML inference (Python worker spawned by the API over stdio; no network port) ---
ML_ENABLED=true
PYTHON_BIN=python3
ML_TIMEOUT_MS=30000
# Defaults to ./aquaguard_model.pkl; the worker refuses any file whose SHA-256 is not pinned in ml/MODEL_SHA256
# AQUAGUARD_MODEL_PATH=

# --- Historical import (database/scripts/import-fwi.js, backend/scripts/dev-local.js) ---
# Folder containing the FWI ara2_*.csv files
# FWI_DATA_DIR=/path/to/Preprocess/csv
